# Docker deployment environment template
# Copy to .env before running:  cp .env.docker.example .env

# ---- 服务 ----
PORT=9000
NODE_ENV=production

# ---- PostgreSQL + pgvector ----
DB_HOST=db
DB_PORT=5432
DB_NAME=ragdb
DB_USER=rag
DB_PASSWORD=ragpass  # change for production

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Embedding / Rerank 服务 ----
# 容器内 embed-server 服务地址（Docker 内部 DNS）
EMBEDDING_ENDPOINT_URL=http://embed-server:8001/embeddings
RERANK_ENDPOINT_URL=http://embed-server:8001/rerank
EMBED_SERVER_PORT=8001
# 国内镜像加速：https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# ---- LLM 服务（OpenAI 兼容）----
# 容器内 llm 服务地址（Docker 内部 DNS），或指向你的 vLLM / Ollama 地址
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL_NAME=Qwen/Qwen1.5-7B-Chat
LLM_API_KEY=

# ---- 检索与切分 ----
CHUNK_SIZE=300
CHUNK_OVERLAP=30
TOP_K_RETRIEVAL=50
TOP_K_RERANK=10
RERANK_THRESHOLD=0.1

# ---- 安全 ----
# 生产环境必须设置 API_KEY 和 ADMIN_API_KEY
API_KEY=
ADMIN_API_KEY=
CORS_ORIGIN=*

# ---- 可观测性 ----
AUDIT_ENABLED=true
CHAT_HISTORY_ENABLED=true
