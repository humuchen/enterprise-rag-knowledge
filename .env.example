# 复制为 .env 后按需修改。所有项均有默认值，见 src/config.ts。
# .env 已被 .gitignore 忽略，本模板随仓库分发。

# ---- 服务 ----
PORT=9000
NODE_ENV=development

# ---- PostgreSQL + pgvector ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdb
DB_USER=rag
DB_PASSWORD=ragpass

# ---- Redis（当前仅建连接，业务未使用）----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- 外部模型服务（必需）----
# BGE-M3 嵌入服务，提供 POST /embeddings 与 POST /rerank
EMBEDDING_ENDPOINT_URL=http://localhost:8001/embeddings
RERANK_ENDPOINT_URL=http://localhost:8001/rerank

# OpenAI 兼容的 LLM 后端（vLLM / Ollama / 通义等）
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=Qwen/Qwen1.5-7B-Chat

# ---- 检索与切分 ----
CHUNK_SIZE=300
CHUNK_OVERLAP=30
TOP_K_RETRIEVAL=50
TOP_K_RERANK=10
# 注意：RERANK_THRESHOLD 目前在 src/retriever.ts 中未被使用
RERANK_THRESHOLD=0.1
