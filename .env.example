# 复制为 .env 后按需修改。所有项均有默认值，见 src/config.ts。
# .env 已被 .gitignore 忽略，本模板随仓库分发。

# ---- 服务 ----
PORT=9000
NODE_ENV=development

# ---- PostgreSQL + pgvector ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdb
DB_USER=rag
DB_PASSWORD=ragpass

# ---- Redis（限流，故障自动放行）----
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60

# ---- 外部模型服务（必需）----
# BGE-M3 嵌入服务，提供 POST /embeddings、POST /rerank、GET /health
# 由 npm run embed-server（src/embed_server.ts，纯 Node + ONNX Runtime）启动，
# 不再依赖任何 Python 环境。下方变量供该服务使用。
EMBEDDING_ENDPOINT_URL=http://localhost:8001/embeddings
RERANK_ENDPOINT_URL=http://localhost:8001/rerank

# ---- embed-server（纯 Node 实现，可选覆盖）----
# 换成其它社区 ONNX 模型时，注意它与 db/init.sql 的向量维度要一致（BGE-M3 为 1024）
EMBED_MODEL_ID=Xenova/bge-m3
EMBED_DTYPE=q8
RERANK_MODEL_ID=onnx-community/bge-reranker-v2-m3-ONNX
RERANK_DTYPE=q8
EMBED_SERVER_PORT=8001
# 国内网络可设镜像加速权重下载：HF_ENDPOINT=https://hf-mirror.com
# HF_ENDPOINT=

# OpenAI 兼容的 LLM 后端（vLLM / Ollama / 通义等）
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=Qwen/Qwen1.5-7B-Chat
LLM_API_KEY=

# ---- 检索与切分 ----
CHUNK_SIZE=300
CHUNK_OVERLAP=30
TOP_K_RETRIEVAL=50
TOP_K_RERANK=10
# 重排后低于该分数的结果会被丢弃
RERANK_THRESHOLD=0.1

# ---- 数据处理 ----
# 入库是否做 PII 脱敏。默认 false：脱敏会让库内内容与原文不一致，
# 检索命中后展示的将是被改写过的文本。
SCRUB_PII=false

# ---- 安全 ----
# 为空时 /api/v1/* 开放（仅开发用，生产启动会告警）；
# /api/v1/admin/* 强制要求 ADMIN_API_KEY，未配置即拒绝。
API_KEY=
ADMIN_API_KEY=
# 逗号分隔白名单；* 表示反射任意来源（此时关闭 credentials）
CORS_ORIGIN=*

# ---- 可观测性 ----
AUDIT_ENABLED=true
CHAT_HISTORY_ENABLED=true
