{
  "name": "enterprise-rag-knowledge",
  "version": "0.1.0",
  "description": "Enterprise-grade RAG knowledge base in TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "ingest": "ts-node src/ingest.ts",
    "backfill-text": "ts-node src/ingest.ts --backfill-text",
    "embed-server": "ts-node src/embed_server.ts",
    "download-models": "node scripts/download-models.mjs",
    "migrate": "ts-node db/migrate.ts",
    "health": "bash scripts/health-check.sh",
    "lint": "eslint src/ db/ --ext .ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.3.0",
    "@fastify/multipart": "^8.2.2",
    "@huggingface/transformers": "^4.2.0",
    "axios": "^1.5.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.28.0",
    "ioredis": "^5.3.2",
    "mammoth": "^1.7.9",
    "mime-types": "^2.1.35",
    "pdf-parse": "^1.1.2",
    "pg": "^8.11.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.3",
    "@types/node": "^20.5.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "eslint": "^8.47.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
